# ---------- 单命令帮助 ----------
help_one() {
  local c="$1"
  if [ "$LANG_CODE" = "zh" ]; then
    case "$c" in
      status)  printf 'msl status\n  查看子系统是否在运行。\n' ;;
      info)    printf 'msl info\n  显示用户、发行版、内核、CPU/内存、磁盘、IP、家目录和 sudo 模式。\n' ;;
      start)   printf 'msl start\n  启动子系统；已经在运行就什么都不做。\n' ;;
      stop)    printf 'msl stop\n  停止子系统，把内存还给 macOS（下次 msl 会自动重新启动）。\n' ;;
      restart) printf 'msl restart\n  重启子系统。\n' ;;
      update)  printf 'msl update\n  在子系统里执行 apt update && apt upgrade（需要 sudo 密码）。\n' ;;
      setup)   printf 'msl setup\n  首次设置：创建 UNIX 账户并初始化实例，等价于第一次直接运行 msl。\n' ;;
      create)  printf 'msl create\n  创建实例。已存在会报错；要重来请用 msl reset。\n' ;;
      reset)   printf 'msl reset\n  删除实例并重新走一遍设置向导。子系统数据会丢，Mac 文件不受影响。\n' ;;
      passwd)  printf 'msl passwd\n  修改子系统里当前账户的密码。\n' ;;
      delete)  printf 'msl delete\n  确认后删除实例，其中的 Linux 数据会丢失。\n' ;;
      list)    printf 'msl list\n  列出所有 Lima 实例。\n' ;;
      help)    printf 'msl help [命令]\n  显示完整帮助，或某一条命令的帮助。\n' ;;
      *) return 1 ;;
    esac
  else
    case "$c" in
      status)  printf 'msl status\n  Show whether the subsystem is running.\n' ;;
      info)    printf 'msl info\n  Show user, distro, kernel, CPU/memory, disk, IP, home and sudo mode.\n' ;;
      start)   printf 'msl start\n  Start the subsystem. Nothing happens if it is already running.\n' ;;
      stop)    printf 'msl stop\n  Stop the subsystem and hand its memory back to macOS (msl starts it again on demand).\n' ;;
      restart) printf 'msl restart\n  Restart the subsystem.\n' ;;
      update)  printf 'msl update\n  Run apt update && apt upgrade inside the guest (asks for the sudo password).\n' ;;
      setup)   printf 'msl setup\n  First-time setup: create your UNIX account and provision the instance.\n' ;;
      create)  printf 'msl create\n  Create the instance. Fails if it exists; use msl reset to start over.\n' ;;
      reset)   printf 'msl reset\n  Delete the instance and run setup again. Guest data is lost, Mac files are safe.\n' ;;
      passwd)  printf 'msl passwd\n  Change the current account password inside the guest.\n' ;;
      delete)  printf 'msl delete\n  Delete the instance after confirmation. Linux data inside it is lost.\n' ;;
      list)    printf 'msl list\n  List all Lima instances.\n' ;;
      help)    printf 'msl help [command]\n  Show the full help, or the help for a single command.\n' ;;
      *) return 1 ;;
    esac
  fi
}

cmd_help() {
  local topic="${1:-}"
  case "$topic" in
    "") usage ;;
    *)  help_one "$topic" || die "$(t "no such command: $topic (see msl --help)" "没有这个命令：${topic}（试试 msl --help）")" ;;
  esac
}

# ---------- 子命令 ----------
cmd_status() {
  local st; st="$(vm_status)"
  [ -z "$st" ] && { printf '%s\n' "$(t "state: not created (run msl setup)" "状态: 未创建（运行 msl setup）")"; exit 1; }
  printf '%s: %s\n%s: %s\n' "$(t "instance" "实例")" "$INSTANCE" "$(t "state" "状态")" "$st"
}

cmd_info() {
  ensure_running
  local raw
  raw="$("$LIMACTL" shell --workdir "$HOST_HOME" "$INSTANCE" -- /bin/bash -lc '
    echo "user=$(id -un) (uid $(id -u))"
    echo "host=$(hostname)"
    echo "distro=$(. /etc/os-release; echo "$PRETTY_NAME")"
    echo "kernel=$(uname -r)"
    echo "cpu=$(nproc)|$(free -h | awk "/^Mem:/{print \$2}")|$(free -h | awk "/^Mem:/{print \$3}")"
    echo "disk=$(df -h / | awk "NR==2{print \$2}")|$(df -h / | awk "NR==2{print \$4}")"
    echo "ip=$(hostname -I | awk "{print \$1}")"
    echo "home=$HOME"
    echo "mac=/Users/$(ls /Users | head -1)"
    if sudo -n true 2>/dev/null; then echo "sudo=passwordless"; else echo "sudo=required"; fi
  ' 2>/dev/null)" || die "$(t "failed to read instance info" "读取实例信息失败")"

  local k v label
  while IFS='=' read -r k v; do
    case "$k" in
      user)   label="$(t "user" "用户")" ;;
      host)   label="$(t "hostname" "主机名")" ;;
      distro) label="$(t "distro" "发行版")" ;;
      kernel) label="$(t "kernel" "内核")" ;;
      cpu)
        label="$(t "cpu / mem" "CPU / 内存")"
        v="$(printf '%s' "$v" | cut -d'|' -f1) / $(printf '%s' "$v" | cut -d'|' -f2) $(t "(used $(printf '%s' "$v" | cut -d'|' -f3))" "（已用 $(printf '%s' "$v" | cut -d'|' -f3)）")"
        ;;
      disk)
        label="$(t "disk" "磁盘")"
        v="$(printf '%s' "$v" | cut -d'|' -f1) $(t total 总) / $(printf '%s' "$v" | cut -d'|' -f2) $(t free 可用)"
        ;;
      ip)     label="$(t "ip" "IP")" ;;
      home)   label="$(t "linux home" "Linux 家目录")" ;;
      mac)    label="$(t "mac files" "Mac 文件")" ;;
      sudo)   label="$(t "sudo" "sudo")" ;;
      *) continue ;;
    esac
    case "$k:$v" in
      mac:*)  v="$v $(t "(same path, read-write)" "（同一个路径，双向可写）")" ;;
      sudo:passwordless) v="$(t "passwordless" "免密")" ;;
      sudo:required)     v="$(t "password required" "需要密码")" ;;
    esac
    printf '%-14s %s\n' "$label" "$v"
  done <<< "$raw"
}

cmd_start() { ensure_running; }
cmd_stop() {
  if [ "$(vm_status)" = "Running" ]; then
    say "$(t "stopping $INSTANCE …" "正在停止 $INSTANCE …")"; "$LIMACTL" stop "$INSTANCE" && say "$(t "stopped" "已停止")"
  else
    printf '%s\n' "$(t "not running." "当前未运行。")"
  fi
}
cmd_restart() {
  say "$(t "restarting $INSTANCE …" "重启 $INSTANCE …")"; "$LIMACTL" restart --tty=false "$INSTANCE"
}
cmd_update() {
  ensure_running
  "$LIMACTL" shell --workdir "$HOST_HOME" "$INSTANCE" -- /bin/bash -lc \
    'sudo apt-get update && sudo apt-get -y upgrade && echo "== up to date =="'
}
cmd_passwd() {
  ensure_running
  exec "$LIMACTL" shell --workdir "$HOST_HOME" "$INSTANCE" -- passwd
}

cmd_create() {
  [ -n "$(vm_status)" ] && die "$(t "instance '$INSTANCE' already exists; use msl reset to start over" \
                                   "实例「${INSTANCE}」已存在；要重来请用 msl reset")"

  if [ -z "$MSL_USER" ] || [ -z "$MSL_PASSWORD" ]; then
    if [ -t 0 ] && [ -t 1 ]; then
      ask_setup
    else
      die "$(t "account required: run msl setup interactively, or set MSL_USER / MSL_PASSWORD" \
              "创建需要账户信息：交互运行 msl setup，或设置 MSL_USER / MSL_PASSWORD")"
    fi
  fi
  [ -n "$PROVISION" ] && [ -f "$PROVISION" ] || die "$(t "provision.sh not found (set MSL_PROVISION)" \
                                                      "找不到 provision.sh（可用 MSL_PROVISION 指定路径）")"

  say "$(t "creating $INSTANCE: ${VM_CPUS} CPU / ${VM_MEM}GiB RAM / ${VM_DISK}GiB disk, user $MSL_USER" \
          "创建 ${INSTANCE}：${VM_CPUS} 核 / ${VM_MEM}GiB 内存 / ${VM_DISK}GiB 磁盘，用户 $MSL_USER")"
  "$LIMACTL" create --name="$INSTANCE" \
    --cpus="$VM_CPUS" --memory="$VM_MEM" --disk="$VM_DISK" \
    --mount-writable --containerd=none --rosetta --tty=false \
    --set ".user.name = \"$MSL_USER\"" \
    --set ".user.home = \"/home/$MSL_USER\"" \
    "$VM_TEMPLATE" || die "$(t "create failed" "创建失败")"

  say "$(t "first boot …" "首次启动 …")"
  if ! "$LIMACTL" start --tty=false --timeout=10m "$INSTANCE" >/tmp/msl-boot.log 2>&1; then
    tail -n 20 /tmp/msl-boot.log >&2
    die "$(t "boot failed" "启动失败")"
  fi

  # 初始化时仍用免密 sudo，装完再收紧
  say "$(t "provisioning: apt, toolchain, fastfetch (~2 min)" \
          "初始化子系统：apt、开发工具、fastfetch（约 2 分钟）")"
  if ! "$LIMACTL" shell --tty=false "$INSTANCE" -- sudo bash -s -- "$MSL_USER" "$HOST_HOME" "$LANG_CODE" < "$PROVISION"; then
    die "$(t "provisioning failed; retry with: msl -c 'sudo bash ~/.config/msl/provision.sh'" \
            "初始化失败；可以手动重跑：msl -c 'sudo bash ~/.config/msl/provision.sh'")"
  fi

  say "$(t "setting password for $MSL_USER …" "设置 $MSL_USER 的登录密码 …")"
  if ! printf '%s' "$MSL_PASSWORD" | "$LIMACTL" shell --tty=false "$INSTANCE" -- \
        sudo bash -c 'IFS= read -r pw; printf "%s:%s\n" "$1" "$pw" | chpasswd' _ "$MSL_USER"; then
    die "$(t "failed to set password" "设置密码失败")"
  fi

  # 和 WSL 一样：sudo 要密码（删掉 cloud-init 写的 NOPASSWD 规则）
  say "$(t "making sudo require a password, like WSL …" "按 WSL 的习惯把 sudo 改成需要密码 …")"
  "$LIMACTL" shell --tty=false "$INSTANCE" -- sudo bash -c \
    'usermod -aG sudo "$1"; rm -f /etc/sudoers.d/90-cloud-init-users' \
    _ "$MSL_USER" || die "$(t "failed to configure sudo" "设置 sudo 规则失败")"

  # Lima 复用 SSH ControlMaster：改组后旧会话里的组还是旧的，必须重连再验证
  "$LIMACTL" shell --reconnect --tty=false "$INSTANCE" -- /bin/bash -c '
    id -nG | tr " " "\n" | grep -qx sudo || { echo "user not in sudo group" >&2; exit 1; }
    if sudo -n true 2>/dev/null; then echo "still passwordless" >&2; exit 1; fi
  ' 2>/dev/null || die "$(t "sudo was not tightened as expected" "sudo 权限没有按预期收紧")"

  printf '\n'
  say "$(t "done. account $MSL_USER is ready — just run: msl" \
          "完成。账户 $MSL_USER 已就绪，从现在起直接敲 msl 进入子系统。")"
}

cmd_reset() {
  if [ -n "$(vm_status)" ]; then
    printf '%s' "$(t "This will delete instance $INSTANCE and set it up again (guest data is lost, Mac files are safe).
Type yes to confirm: " \
                     "将删除实例 $INSTANCE 并重新设置（子系统里的数据会丢，Mac 文件不受影响）。
输入 yes 确认: ")"
    read -r ans
    [ "$ans" = "yes" ] || { printf '%s\n' "$(t "cancelled." "已取消。")"; exit 1; }
    "$LIMACTL" delete -f "$INSTANCE" || die "$(t "delete failed" "删除失败")"
  fi
  cmd_create
}

cmd_delete() {
  [ -n "$(vm_status)" ] || die "$(t "instance '$INSTANCE' does not exist" "实例「${INSTANCE}」不存在")"
  printf '%s' "$(t "This will delete instance $INSTANCE and all Linux data in it (your Mac home is untouched).
Type yes to confirm: " \
                   "将删除实例 ${INSTANCE}，其中所有 Linux 数据都会丢失（Mac 家目录不受影响）。
输入 yes 确认: ")"
  read -r ans
  [ "$ans" = "yes" ] || { printf '%s\n' "$(t "cancelled." "已取消。")"; exit 1; }
  "$LIMACTL" delete -f "$INSTANCE" && printf '%s\n' "$(t "deleted." "已删除。")"
}
cmd_list() { "$LIMACTL" list; }

# ---------- 参数解析 ----------
CMD_STRING=""
RUN_USER=""
WORKDIR=""
POSITIONAL=()

while [ $# -gt 0 ]; do
  # 命令一旦开始，后面的参数（包括 -x）原样交给命令，不再由 msl 解析
  if [ ${#POSITIONAL[@]} -gt 0 ]; then
    POSITIONAL+=("$1"); shift; continue
  fi
  case "$1" in
    -h|--help)      usage; exit 0 ;;
    -V|--version)   printf 'msl %s (limactl %s)\n' "$VERSION" "$("$LIMACTL" --version 2>/dev/null | awk '{print $3}')"; exit 0 ;;
    -c|--command)   [ $# -ge 2 ] || die "$(t "-c requires an argument" "-c 需要参数")"; CMD_STRING="$2"; shift 2 ;;
    -u|--user)      [ $# -ge 2 ] || die "$(t "-u requires an argument" "-u 需要参数")"; RUN_USER="$2"; shift 2 ;;
    -C|--cd)        [ $# -ge 2 ] || die "$(t "-C requires an argument" "-C 需要参数")"; WORKDIR="$2"; shift 2 ;;
    --)             shift; POSITIONAL+=("$@"); break ;;
    -*)             die "$(t "unknown option: $1 (see msl --help)" "未知选项: $1（msl --help 查看用法）")" ;;
    *)              POSITIONAL+=("$1"); shift ;;
  esac
done

# 子命令（仅在第一个位置参数且没有 -c/-u 时生效）
if [ -z "$CMD_STRING" ] && [ -z "$RUN_USER" ] && [ ${#POSITIONAL[@]} -gt 0 ]; then
  SUB="${POSITIONAL[0]}"
  case "$SUB" in
    status|info|start|stop|restart|update|create|delete|list|help|setup|reset|passwd)
      # msl <命令> --help / -h → 单命令帮助
      if [ ${#POSITIONAL[@]} -gt 1 ]; then
        case "${POSITIONAL[1]}" in
          -h|--help) cmd_help "$SUB"; exit 0 ;;
        esac
      fi
      case "$SUB" in
        status)  cmd_status ;;
        info)    cmd_info ;;
        start)   cmd_start ;;
        stop)    cmd_stop ;;
        restart) cmd_restart ;;
        update)  cmd_update ;;
        create)  cmd_create ;;
        setup)   cmd_create ;;
        reset)   cmd_reset ;;
        passwd)  cmd_passwd ;;
        delete)  cmd_delete ;;
        list)    cmd_list ;;
        help)    cmd_help "${POSITIONAL[1]:-}" ;;
      esac
      exit $?
      ;;
  esac
fi

# ---------- 执行 ----------
# 还没建实例：交互模式下直接进入设置向导（WSL 的第一次启动体验）
if [ -z "$(vm_status)" ]; then
  if [ ${#POSITIONAL[@]} -eq 0 ] && [ -z "$CMD_STRING" ] && [ -t 0 ] && [ -t 1 ]; then
    cmd_create
  else
    die "$(t "no subsystem yet; run: msl setup" "还没有子系统，先运行：msl setup")"
  fi
fi

ensure_running

if [ -n "$WORKDIR" ]; then
  wd="$WORKDIR"
else
  wd="$(guest_pwd)"
fi
# 只接受子系统内存在的目录
[ -d "$wd" ] || wd="$HOST_HOME"

if [ -n "$CMD_STRING" ]; then
  if [ "$RUN_USER" = "root" ]; then
    exec "$LIMACTL" shell --workdir "$wd" "$INSTANCE" -- sudo -H -- /bin/bash -lc "$CMD_STRING"
  elif [ -n "$RUN_USER" ]; then
    exec "$LIMACTL" shell --workdir "$wd" "$INSTANCE" -- sudo -H -u "$RUN_USER" -- /bin/bash -lc "$CMD_STRING"
  fi
  exec "$LIMACTL" shell --workdir "$wd" "$INSTANCE" -- /bin/bash -lc "$CMD_STRING"
fi

if [ ${#POSITIONAL[@]} -gt 0 ]; then
  if [ "$RUN_USER" = "root" ]; then
    exec "$LIMACTL" shell --workdir "$wd" "$INSTANCE" -- sudo -H -- "${POSITIONAL[@]}"
  elif [ -n "$RUN_USER" ]; then
    exec "$LIMACTL" shell --workdir "$wd" "$INSTANCE" -- sudo -H -u "$RUN_USER" -- "${POSITIONAL[@]}"
  fi
  exec "$LIMACTL" shell --workdir "$wd" "$INSTANCE" -- "${POSITIONAL[@]}"
fi

# 交互 shell
[ -t 0 ] || die "$(t "not a terminal: use msl -c 'cmd' or msl cmd args" "非交互终端：请用 msl -c '命令' 或 'msl 命令 参数'")"
if [ -n "$RUN_USER" ]; then
  if [ "$RUN_USER" = "root" ]; then
    exec "$LIMACTL" shell --workdir "$wd" "$INSTANCE" -- sudo -H -i
  fi
  exec "$LIMACTL" shell --workdir "$wd" "$INSTANCE" -- sudo -H -u "$RUN_USER" -- bash -l
fi
exec "$LIMACTL" shell --workdir "$wd" "$INSTANCE"
