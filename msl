#!/usr/bin/env bash
# msl —— 像 WSL 一样在 macOS 上使用 Ubuntu 子系统（基于 Lima / Virtualization.framework）
#
#   msl                     进入 Ubuntu 交互 shell（停着会自动启动）
#   msl -c 'apt update'    在子系统中执行命令
#   msl ls -l               直接执行命令（不经 shell）
#   msl status|info|start|stop|restart|update|create|delete
#
set -u -o pipefail

INSTANCE="${MSL_INSTANCE:-${WSM_INSTANCE:-ubuntu}}"
HOST_HOME="$HOME"

# ---------- 定位 limactl ----------
LIMACTL="${MSL_LIMACTL:-${WSM_LIMACTL:-}}"
if [ -z "$LIMACTL" ]; then
  for c in limactl /opt/homebrew/bin/limactl /usr/local/bin/limactl; do
    if command -v "$c" >/dev/null 2>&1; then LIMACTL="$c"; break; fi
  done
fi
if [ -z "$LIMACTL" ]; then
  printf 'msl: 找不到 limactl，请先执行: brew install lima\n' >&2
  exit 127
fi

# 创建参数（create / 重建时使用）
VM_CPUS="${MSL_CPUS:-${WSM_CPUS:-4}}"
VM_MEM="${MSL_MEM:-${WSM_MEM:-8}}"
VM_DISK="${MSL_DISK:-${WSM_DISK:-48}}"
VM_TEMPLATE="${MSL_TEMPLATE:-${WSM_TEMPLATE:-template:ubuntu-24.04}}"

# ---------- 小工具 ----------
die()  { printf '\033[31mmsl:\033[0m %s\n' "$*" >&2; exit 1; }
say()  { printf '\033[36m>>\033[0m %s\n' "$*" >&2; }

vm_status() {
  "$LIMACTL" list --format '{{.Status}}' "$INSTANCE" 2>/dev/null | head -n1
}

ensure_running() {
  local st; st="$(vm_status)"
  if [ "$st" = "Running" ]; then return 0; fi
  if [ -z "$st" ]; then
    die "实例「$INSTANCE」不存在，请先运行：msl create"
  fi
  say "Ubuntu 子系统未运行，正在启动 …"
  local log; log="$(mktemp -t msl-start)"
  if ! "$LIMACTL" start --tty=false "$INSTANCE" >"$log" 2>&1; then
    printf '\n' >&2; tail -n 20 "$log" >&2
    die "启动失败，完整日志：$log"
  fi
  say "已启动"
}

# 当前目录在 Mac 家目录内就沿用，否则落到子系统的家目录
guest_pwd() {
  case "$PWD" in
    "$HOST_HOME" | "$HOST_HOME"/*) printf '%s' "$PWD" ;;
    *) printf '%s' "$HOST_HOME" ;;
  esac
}

# ---------- 帮助 ----------
usage() {
  cat <<'EOF'
msl —— MSL: macOS Subsystem for Linux
（呼应 WSL = Windows Subsystem for Linux；本机 Ubuntu 子系统，别名 wsm / ubuntu）

用法:
  msl                          进入 Ubuntu shell（当前目录会自动带过去）
  msl -c '命令'                用 bash 执行命令（支持管道、重定向）
  msl 命令 参数...             直接执行命令，例如 msl ls -l /  msl python3 a.py
  msl -u USER [-c '命令']      以指定用户执行（-u root 进 root shell）
  msl -C 目录 ...              在子系统的指定目录里执行

子命令:
  status      查看运行状态
  info        查看配置、IP、挂载、资源占用
  start       启动
  stop        停止（释放内存）
  restart     重启
  update      子系统内 apt update && apt upgrade
  create      创建（或重建）实例
  delete      删除实例（需确认，数据会丢）
  list        列出所有 Lima 实例

环境变量:
  MSL_INSTANCE   实例名，默认 ubuntu（可起多个发行版并存）
  MSL_CPUS/MSL_MEM/MSL_DISK  重建时的资源配置，默认 4 / 8GiB / 48GiB
  MSL_TEMPLATE   重建时的模板，默认 template:ubuntu-24.04

提示: Mac 家目录在子系统里是同一个路径（/Users/你的用户名），双向可写。
EOF
}

# ---------- 子命令 ----------
cmd_status() {
  local st; st="$(vm_status)"
  [ -z "$st" ] && { printf '状态: 未创建\n'; exit 1; }
  printf '实例: %s\n状态: %s\n' "$INSTANCE" "$st"
}

cmd_info() {
  ensure_running
  "$LIMACTL" shell --workdir "$HOST_HOME" "$INSTANCE" -- /bin/bash -lc '
    printf "主机名      : %s\n" "$(hostname)"
    printf "发行版      : %s\n" "$(. /etc/os-release; echo "$PRETTY_NAME")"
    printf "内核        : %s\n" "$(uname -r)"
    printf "CPU / 内存  : %s 核 / %s（已用 %s）\n" "$(nproc)" \
      "$(free -h | awk "/^Mem:/{print \$2}")" "$(free -h | awk "/^Mem:/{print \$3}")"
    printf "磁盘        : %s 总 / %s 可用\n" "$(df -h / | awk "NR==2{print \$2}")" "$(df -h / | awk "NR==2{print \$4}")"
    printf "IP          : %s\n" "$(hostname -I | awk "{print \$1}")"
    printf "Linux 家目录: %s\n" "$HOME"
    printf "Mac 文件    : /Users/%s（同一个路径，双向可写）\n" "$(ls /Users | head -1)"
    printf "sudo        : %s\n" "$(sudo -n true 2>/dev/null && echo "免密可用" || echo "需要密码")"
  ' 2>/dev/null || die "读取实例信息失败"
}

cmd_start() { ensure_running; }
cmd_stop() {
  if [ "$(vm_status)" = "Running" ]; then
    say "正在停止 $INSTANCE …"; "$LIMACTL" stop "$INSTANCE" && say "已停止"
  else
    printf '当前未运行。\n'
  fi
}
cmd_restart() {
  say "重启 $INSTANCE …"; "$LIMACTL" restart --tty=false "$INSTANCE"
}
cmd_update() {
  ensure_running
  "$LIMACTL" shell --workdir "$HOST_HOME" "$INSTANCE" -- /bin/bash -lc \
    'sudo apt-get update && sudo apt-get -y upgrade && echo "== 子系统已是最新 =="'
}
cmd_create() {
  [ -n "$(vm_status)" ] && die "实例「$INSTANCE」已存在；要重建请先 msl delete"
  say "创建 $INSTANCE（$VM_CPUS 核 / ${VM_MEM}GiB / ${VM_DISK}GiB）…"
  "$LIMACTL" create --name="$INSTANCE" \
    --cpus="$VM_CPUS" --memory="$VM_MEM" --disk="$VM_DISK" \
    --mount-writable --containerd=none --rosetta --tty=false \
    "$VM_TEMPLATE" || die "创建失败"
  say "创建完成，开始启动"
  ensure_running
}
cmd_delete() {
  [ -n "$(vm_status)" ] || die "实例「$INSTANCE」不存在"
  printf '将删除实例 %s，其中所有 Linux 数据都会丢失（Mac 家目录不受影响）。\n输入 yes 确认: ' "$INSTANCE"
  read -r ans
  [ "$ans" = "yes" ] || { printf '已取消。\n'; exit 1; }
  "$LIMACTL" delete -f "$INSTANCE" && printf '已删除。\n'
}
cmd_list() { "$LIMACTL" list; }

# ---------- 参数解析 ----------
CMD_STRING=""
RUN_USER=""
WORKDIR=""
POSITIONAL=()

while [ $# -gt 0 ]; do
  # 命令一旦开始，后面的参数（包括 -x）原样交给命令，不再由 msl 解析
  if [ ${#POSITIONAL[@]} -gt 0 ]; then
    POSITIONAL+=("$1"); shift; continue
  fi
  case "$1" in
    -h|--help)      usage; exit 0 ;;
    -V|--version)   printf 'msl 1.0 (limactl %s)\n' "$("$LIMACTL" --version 2>/dev/null | awk '{print $3}')"; exit 0 ;;
    -c|--command)   [ $# -ge 2 ] || die "-c 需要参数"; CMD_STRING="$2"; shift 2 ;;
    -u|--user)      [ $# -ge 2 ] || die "-u 需要参数"; RUN_USER="$2"; shift 2 ;;
    -C|--cd)        [ $# -ge 2 ] || die "-C 需要参数"; WORKDIR="$2"; shift 2 ;;
    --)             shift; POSITIONAL+=("$@"); break ;;
    -*)             die "未知选项: $1（msl --help 查看用法）" ;;
    *)              POSITIONAL+=("$1"); shift ;;
  esac
done

# 子命令（仅在第一个位置参数且没有 -c/-u 时生效）
if [ -z "$CMD_STRING" ] && [ -z "$RUN_USER" ] && [ ${#POSITIONAL[@]} -gt 0 ]; then
  case "${POSITIONAL[0]}" in
    status|info|start|stop|restart|update|create|delete|list|help)
      sub="${POSITIONAL[0]}"; shift_args=( "${POSITIONAL[@]:1}" )
      case "$sub" in
        status)  cmd_status ;;
        info)    cmd_info ;;
        start)   cmd_start ;;
        stop)    cmd_stop ;;
        restart) cmd_restart ;;
        update)  cmd_update ;;
        create)  cmd_create ;;
        delete)  cmd_delete ;;
        list)    cmd_list ;;
        help)    usage ;;
      esac
      exit $?
      ;;
  esac
fi

# ---------- 执行 ----------
ensure_running

if [ -n "$WORKDIR" ]; then
  wd="$WORKDIR"
else
  wd="$(guest_pwd)"
fi
# 只接受子系统内存在的目录
[ -d "$wd" ] || wd="$HOST_HOME"

# 以 --user 指定的身份执行时，统一套一层 sudo（Lima 默认用户已免密）
if [ -n "$CMD_STRING" ]; then
  if [ "$RUN_USER" = "root" ]; then
    exec "$LIMACTL" shell --workdir "$wd" "$INSTANCE" -- sudo -H -- /bin/bash -lc "$CMD_STRING"
  elif [ -n "$RUN_USER" ]; then
    exec "$LIMACTL" shell --workdir "$wd" "$INSTANCE" -- sudo -H -u "$RUN_USER" -- /bin/bash -lc "$CMD_STRING"
  fi
  exec "$LIMACTL" shell --workdir "$wd" "$INSTANCE" -- /bin/bash -lc "$CMD_STRING"
fi

if [ ${#POSITIONAL[@]} -gt 0 ]; then
  if [ "$RUN_USER" = "root" ]; then
    exec "$LIMACTL" shell --workdir "$wd" "$INSTANCE" -- sudo -H -- "${POSITIONAL[@]}"
  elif [ -n "$RUN_USER" ]; then
    exec "$LIMACTL" shell --workdir "$wd" "$INSTANCE" -- sudo -H -u "$RUN_USER" -- "${POSITIONAL[@]}"
  fi
  exec "$LIMACTL" shell --workdir "$wd" "$INSTANCE" -- "${POSITIONAL[@]}"
fi

# 交互 shell
[ -t 0 ] || die "非交互终端：请用 msl -c '命令' 或 'msl 命令 参数'"
if [ -n "$RUN_USER" ]; then
  if [ "$RUN_USER" = "root" ]; then
    exec "$LIMACTL" shell --workdir "$wd" "$INSTANCE" -- sudo -H -i
  fi
  exec "$LIMACTL" shell --workdir "$wd" "$INSTANCE" -- sudo -H -u "$RUN_USER" -- bash -l
fi
exec "$LIMACTL" shell --workdir "$wd" "$INSTANCE"
