# msl —— MSL: macOS Subsystem for Linux
# 像 WSL 一样在 macOS 上使用 Ubuntu 子系统（Lima + Virtualization.framework）
#
#   msl                     进入 Ubuntu 交互 shell（第一次会自动进入设置向导）
#   msl -c 'apt update'     在子系统中执行命令
#   msl ls -l               直接执行命令（不经 shell）
#   msl status|info|start|stop|restart|update|setup|reset|passwd|delete
#
# 提示语言跟随 locale（LC_ALL / LC_MESSAGES / LANGUAGE / LANG），可用 MSL_LANG=zh|en 强制。
set -u -o pipefail

VERSION="1.2.1"

INSTANCE="${MSL_INSTANCE:-${WSM_INSTANCE:-ubuntu}}"
HOST_HOME="$HOME"
SELF_DIR="$(cd "$(dirname "$0")" && pwd)"

# ---------- 语言 ----------
detect_lang() {
  local v val
  if [ -n "${MSL_LANG:-}" ]; then
    case "$MSL_LANG" in zh*) printf zh ;; *) printf en ;; esac
    return
  fi
  for v in LC_ALL LC_MESSAGES LANGUAGE LANG; do
    eval "val=\${$v:-}"
    case "$val" in
      ""|C|POSIX) continue ;;
      zh*) printf zh; return ;;
      *) printf en; return ;;
    esac
  done
  printf en
}
LANG_CODE="$(detect_lang)"

# t 英文 中文 → 按当前语言输出
t() {
  if [ "$LANG_CODE" = "zh" ]; then printf '%s' "$2"; else printf '%s' "$1"; fi
}

# ---------- 定位 limactl ----------
LIMACTL="${MSL_LIMACTL:-${WSM_LIMACTL:-}}"
if [ -z "$LIMACTL" ]; then
  for c in limactl /opt/homebrew/bin/limactl /usr/local/bin/limactl; do
    if command -v "$c" >/dev/null 2>&1; then LIMACTL="$c"; break; fi
  done
fi
if [ -z "$LIMACTL" ]; then
  printf 'msl: %s\n' "$(t "limactl not found; run: brew install lima" "找不到 limactl，请先执行: brew install lima")" >&2
  exit 127
fi

# ---------- 初始化脚本位置 ----------
if [ -n "${MSL_PROVISION:-}" ]; then
  PROVISION="$MSL_PROVISION"
elif [ -f "$HOME/.config/msl/provision.sh" ]; then
  PROVISION="$HOME/.config/msl/provision.sh"
elif [ -f "$SELF_DIR/provision/provision.sh" ]; then
  PROVISION="$SELF_DIR/provision/provision.sh"
elif [ -f "$SELF_DIR/provision.sh" ]; then
  PROVISION="$SELF_DIR/provision.sh"
else
  PROVISION=""
fi

# 创建参数（create / reset 时使用）
VM_CPUS="${MSL_CPUS:-${WSM_CPUS:-4}}"
VM_MEM="${MSL_MEM:-${WSM_MEM:-8}}"
VM_DISK="${MSL_DISK:-${WSM_DISK:-48}}"
VM_TEMPLATE="${MSL_TEMPLATE:-${WSM_TEMPLATE:-template:ubuntu-24.04}}"

# 首次设置的账户（非交互场景可以用环境变量直接给）
MSL_USER="${MSL_USER:-}"
MSL_PASSWORD="${MSL_PASSWORD:-}"

# ---------- 小工具 ----------
die()  { printf '\033[31mmsl:\033[0m %s\n' "$*" >&2; exit 1; }
say()  { printf '\033[36m>>\033[0m %s\n' "$*" >&2; }

vm_status() {
  "$LIMACTL" list --format '{{.Status}}' "$INSTANCE" 2>/dev/null | head -n1
}

ensure_running() {
  local st; st="$(vm_status)"
  if [ "$st" = "Running" ]; then return 0; fi
  if [ -z "$st" ]; then
    die "$(t "instance '$INSTANCE' does not exist; run: msl setup" "实例「${INSTANCE}」不存在，先运行：msl setup")"
  fi
  say "$(t "Ubuntu subsystem is not running, starting …" "Ubuntu 子系统未运行，正在启动 …")"
  local log; log="$(mktemp -t msl-start)"
  if ! "$LIMACTL" start --tty=false "$INSTANCE" >"$log" 2>&1; then
    printf '\n' >&2; tail -n 20 "$log" >&2
    die "$(t "failed to start; full log: $log" "启动失败，完整日志：$log")"
  fi
  say "$(t "started" "已启动")"
}

# 当前目录在 Mac 家目录内就沿用，否则落到子系统的家目录
guest_pwd() {
  case "$PWD" in
    "$HOST_HOME" | "$HOST_HOME"/*) printf '%s' "$PWD" ;;
    *) printf '%s' "$HOST_HOME" ;;
  esac
}

# ---------- 首次设置向导（WSL 风格） ----------
valid_user() {
  local n="$1"
  [ ${#n} -ge 3 ] && [ ${#n} -le 32 ] || return 1
  case "$n" in [a-z]*) ;; *) return 1 ;; esac
  case "$n" in *[!a-z0-9_-]*) return 1 ;; esac
  case "$n" in root|daemon|bin|sys|sync|nobody) return 1 ;; esac
  return 0
}

ask_setup() {
  local name pass pass2
  printf '\n'
  printf '  \033[1mMSL —— macOS Subsystem for Linux\033[0m\n'
  printf '  %s\n\n' "$(t "First run: create an account for your Ubuntu subsystem." \
                         "第一次使用，先为 Ubuntu 子系统创建账户。")"
  while :; do
    printf '  %s' "$(t "Enter new UNIX username: " "请输入新的 UNIX 用户名: ")"
    read -r name || die "$(t "cancelled" "已取消")"
    if valid_user "$name"; then break; fi
    printf '  \033[31m%s\033[0m\n' "$(t "3-32 chars, lowercase letter first, only a-z 0-9 - _" \
                                          "用户名要 3-32 位、小写字母开头，只能用小写字母/数字/-/_")"
  done
  while :; do
    printf '  %s' "$(t "New password: " "新密码: ")"
    read -r -s pass || die "$(t "cancelled" "已取消")"; printf '\n'
    if [ ${#pass} -lt 8 ] && [ "${MSL_ALLOW_WEAK:-0}" != "1" ]; then
      printf '  \033[31m%s\033[0m\n' "$(t "at least 8 characters (set MSL_ALLOW_WEAK=1 to bypass)" \
                                            "密码至少 8 位（想用短密码可以设 MSL_ALLOW_WEAK=1）")"
      continue
    fi
    printf '  %s' "$(t "Retype new password: " "确认新密码: ")"
    read -r -s pass2 || die "$(t "cancelled" "已取消")"; printf '\n'
    if [ "$pass" != "$pass2" ]; then
      printf '  \033[31m%s\033[0m\n' "$(t "passwords do not match, try again" "两次输入不一致，重来")"
      continue
    fi
    break
  done
  MSL_USER="$name"; MSL_PASSWORD="$pass"
  printf '\n'
}

# ---------- 帮助 ----------
