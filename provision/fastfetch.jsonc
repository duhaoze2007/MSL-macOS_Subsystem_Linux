{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "source": "ubuntu",
    "padding": { "top": 1, "left": 2 }
  },
  "display": {
    "separator": "  "
  },
  "modules": [
    "title",
    "separator",
    { "type": "os" },
    { "type": "host" },
    { "type": "kernel" },
    { "type": "uptime" },
    { "type": "packages" },
    { "type": "cpu" },
    { "type": "memory" },
    { "type": "disk", "folders": "/" },
    { "type": "localip" },
    { "type": "locale" }
  ]
}
